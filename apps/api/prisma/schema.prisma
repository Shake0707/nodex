generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id             Int      @id @default(autoincrement())
  name_uz        String
  name_en        String
  name_ru        String
  role_uz        String
  role_en        String
  role_ru        String
  description_uz String
  description_en String
  description_ru String
  photo_url      String   @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("members")
}

model Event {
  id                Int      @id @default(autoincrement())
  title_uz          String
  title_en          String
  title_ru          String
  description_uz    String
  description_en    String
  description_ru    String
  image_url         String   @default("")
  preview_image_url String   @default("")
  images            Json     @default("[]")
  event_date        DateTime
  location          String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("events")
}

model Partner {
  id              Int      @id @default(autoincrement())
  name            String
  logo_image_url  String   @default("")
  website_url     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("partners")
}

model Admin {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  created_at    DateTime @default(now())
  surveys       Survey[]

  @@map("admins")
}

model Survey {
  id               Int                  @id @default(autoincrement())
  title_uz         String
  title_en         String
  title_ru         String
  description_uz   String
  description_en   String
  description_ru   String
  marquee_text_uz  String
  marquee_text_en  String
  marquee_text_ru  String
  is_active        Boolean              @default(false)
  starts_at        DateTime
  ends_at          DateTime?
  registrations    SurveyRegistration[]
  created_by_id    Int?
  created_by       Admin?               @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  @@map("surveys")
}

model SurveyRegistration {
  id           Int      @id @default(autoincrement())
  survey_id    Int
  survey       Survey   @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  first_name   String
  last_name    String
  age          Int
  email        String
  telegram     String?
  school       String
  grade        String
  submitted_at DateTime @default(now())

  @@map("survey_registrations")
}
