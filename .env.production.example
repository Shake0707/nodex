# ─── PostgreSQL (Docker container) ───
POSTGRES_DB=nodex
POSTGRES_USER=nodex
POSTGRES_PASSWORD=сюда_вставь_пароль_для_базы

# ─── Database URL (автоматически собирается в docker-compose.yml) ───
# Если нужно подключиться извне: postgresql://nodex:ПАРОЛЬ@localhost:2050/nodex

# ─── Случайная строка минимум 32 символа (можно сгенерировать: openssl rand -hex 32) ───
SESSION_SECRET=сюда_вставь_случайную_строку

# ─── Secure cookies (true = HTTPS только, false = HTTP тоже) ───
# На продакшене (HTTPS) ставь true. Локально через HTTP — false.
SECURE_COOKIES=true

# ─── Домен сайта ───
CORS_ORIGIN=https://nodex.uz

# ─── URL API — оставь как есть если домен nodex.uz ───
NEXT_PUBLIC_API_URL=https://nodex.uz/api
NEXT_PUBLIC_SITE_URL=https://nodex.uz

# ─── Внутренний URL API для SSR (Next.js → api контейнер напрямую) ───
# Не менять: имя сервиса в docker-compose.yml
INTERNAL_API_URL=http://api:4000/api
